# Copy this file to .env and set your provider, key and models.
# Defaults assume an OpenAI-compatible API; adjust for Azure, Anthropic, or a local model.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your-own-key-here
LLM_EMBED_MODEL=text-embedding-3-small
LLM_CHAT_MODEL=gpt-4o

# The grounding check reads one answer against the excerpts it cited and says
# which claims they do not support. Smaller job than answering, so a cheaper
# model is the point.
#   off      no check
#   shadow   check runs and is recorded, the customer still gets the answer
#   enforce  an unsupported answer is withheld
# Shadow costs one extra call per answered question. That is deliberate: it is
# how you find out whether the check is worth enforcing before it can withhold
# anything from anyone.
LLM_JUDGE_MODEL=gpt-4o-mini
JUDGE_MODE=shadow

# Retrieval settings (optional, these are the defaults).
# RAG_TOP_K     how many chunks are put in front of the model.
# RAG_MIN_SCORE the cheap gate: below this cosine score the question is refused
#               without a chat call.
# Both are chosen from data rather than by feel, see `python evaluate.py --sweep`.
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
