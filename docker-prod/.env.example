# Copy to docker-prod/.env on the server. This file is never committed.
LLM_API_KEY=sk-your-key-here

# Optional, these are the defaults.
LLM_API_BASE=https://api.openai.com/v1
LLM_EMBED_MODEL=text-embedding-3-small
LLM_CHAT_MODEL=gpt-4o
LLM_JUDGE_MODEL=gpt-4o-mini

# off | shadow | enforce. Shadow records what the grounding check found and
# still returns the answer, at the cost of one extra model call per answer.
JUDGE_MODE=shadow

RAG_TOP_K=4
RAG_MIN_SCORE=0.25
